# Sourced by Xcode build phases (no login shell / limited PATH).
# For a machine-specific path, copy to `.xcode.env.local` (gitignored) and set NODE_BINARY there.

# nvm (optional)
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use

# Homebrew Apple Silicon / Intel — adjust if you use fnm/asdf only
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [ -z "$NODE_BINARY" ] || [ ! -x "$NODE_BINARY" ]; then
  export NODE_BINARY="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$NODE_BINARY" ] || [ ! -x "$NODE_BINARY" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then
      export NODE_BINARY="$candidate"
      break
    fi
  done
fi
